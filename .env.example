# ==============================================================================
# CONFIGURAÇÕES DE AMBIENTE - K-POP CEG MANAGER
# ==============================================================================

# 1. Django Core
DEBUG=False
SECRET_KEY=sua-chave-secreta-forte-aqui
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.onrender.com

# 2. Banco de Dados (PostgreSQL no Render / Neon / Supabase)
# Deixe vazio localmente para usar SQLite (db.sqlite3)
DATABASE_URL=postgres://ceguser:senha@host:5432/cegdb

# 3. Superusuário Inicial (Render build.sh)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@example.com

# 4. Armazenamento de Imagens na Nuvem - Cloudflare R2 (Object Storage S3)
# O Django faz upload direto para o Cloudflare R2 e salva apenas o link no banco
USE_R2=True
R2_BUCKET_NAME=ceg-media
R2_ENDPOINT_URL=https://<SEU_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<SUA_R2_ACCESS_KEY_ID>
R2_SECRET_ACCESS_KEY=<SUA_R2_SECRET_ACCESS_KEY>
# Domínio público do R2 (ex: pub-xxx.r2.dev ou subdomínio próprio media.seusite.com)
R2_CUSTOM_DOMAIN=pub-xxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# 5. WhatsApp Gateway (Envio de Códigos OTP e Notificações)
# Opções: 'console' (modo teste local), 'evolution' (Evolution API) ou 'zapi' (Z-API)
WHATSAPP_PROVIDER=console

# Configurações se WHATSAPP_PROVIDER=evolution
EVOLUTION_API_URL=https://sua-evolution-api.com
EVOLUTION_API_KEY=sua-api-key-global
EVOLUTION_INSTANCE_NAME=ceg-bot

# Configurações se WHATSAPP_PROVIDER=zapi
ZAPI_INSTANCE_ID=sua-instancia-zapi
ZAPI_TOKEN=seu-token-zapi
ZAPI_CLIENT_TOKEN=seu-client-token-opcional
