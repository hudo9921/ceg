(security_headers) {
    # Compressão das páginas HTML/JSON (estáticos já saem pré-comprimidos pelo WhiteNoise).
    encode zstd gzip
    header {
        # CSP e Permissions-Policy são enviados pelo Django (apps/core/security_headers.py).
        -Server
    }
}

valcegs.duckdns.org {
    import security_headers
    reverse_proxy ceg-web:8000
}

129.213.164.99.sslip.io {
    import security_headers
    reverse_proxy ceg-web:8000
}

:80 {
    # Acesso HTTP pelo IP cru: redireciona para o domínio com HTTPS (cookies são Secure).
    redir https://valcegs.duckdns.org{uri} permanent
}
