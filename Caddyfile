(security_headers) {
    header {
        # CSP mínima compatível com o Tailwind Play CDN / Alpine (sem bloquear scripts inline):
        # impede sequestro via <base>, plugins, iframes de terceiros e forms enviados para fora.
        Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        -Server
    }
}

valcegs.duckdns.org {
    import security_headers
    reverse_proxy ceg-web:8000
}

150.136.166.17.sslip.io {
    import security_headers
    reverse_proxy ceg-web:8000
}

:80 {
    # Acesso HTTP pelo IP cru: redireciona para o domínio com HTTPS (cookies são Secure).
    redir https://valcegs.duckdns.org{uri} permanent
}
