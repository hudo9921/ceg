    import security_headers
    reverse_proxy ceg-web:8000
}

:80 {
    # Acesso HTTP pelo IP cru: redireciona para o domínio com HTTPS (cookies são Secure).
    redir https://valcegs.duckdns.org{uri} permanent
}
